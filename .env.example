# Local development defaults for the current application scaffold.
APP_NAME="Alliance Payments"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL is used by the application; set your local database credentials.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=alliance_payments
DB_USERNAME=postgres
DB_PASSWORD=
# DB_URL=

# Required by DemoUsersSeeder; set separate passwords in your local .env.
DEMO_ADMIN_PASSWORD=
DEMO_EDITOR_PASSWORD=
DEMO_VIEWER_PASSWORD=
# To promote another existing account: php artisan users:admin user@alliance.ge

# Used by the existing Breeze/Inertia session authentication.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Enable secure cookies when serving the application over HTTPS.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# DB_QUEUE_CONNECTION=
# DB_QUEUE=default
# DB_QUEUE_RETRY_AFTER=90
# QUEUE_FAILED_DRIVER=database-uuids

CACHE_STORE=database
# CACHE_PREFIX=

# Optional cache backends; not needed with CACHE_STORE=database.
MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_USERNAME=null
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
# REDIS_URL=
# REDIS_CACHE_CONNECTION=cache
# REDIS_QUEUE_CONNECTION=default
# REDIS_QUEUE=default
# REDIS_QUEUE_RETRY_AFTER=90

# The log mailer records messages locally without sending email.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@alliance-payments.test"
MAIL_FROM_NAME="${APP_NAME}"

# Optional S3 storage; the default FILESYSTEM_DISK=local does not use AWS.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# AWS_URL=
# AWS_ENDPOINT=

# Use a FrankenPHP binary built with PHP 8.4 (see README).
OCTANE_SERVER=frankenphp
OCTANE_HOST=127.0.0.1
OCTANE_PORT=8000
OCTANE_WORKERS=4
OCTANE_MAX_REQUESTS=500
OCTANE_HTTPS=false
# OCTANE_STATE_FILE=/absolute/path/to/storage/logs/octane-server-state.json

VITE_APP_NAME="${APP_NAME}"
